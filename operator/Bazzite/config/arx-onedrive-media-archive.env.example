# Optional: ~/.config/arx-onedrive-media-archive.env
#
# If auto-detection fails, set the sync root that contains Media/:
# ARX_ONEDRIVE_ROOT=/home/YOU/OneDrive
#
# Where large files are moved (default: ~/Videos/OneDrive-Media-Archive):
# ARX_MEDIA_ARCHIVE_DEST=/home/YOU/Videos/OneDrive-Media-Archive
#
# Minimum size to move, in MB (default 20):
# ARX_MEDIA_MIN_MB=20
#
# Logs (default: ~/.local/state/arx-onedrive-media-archive/logs):
# ARX_MEDIA_LOG_DIR=/home/YOU/.local/state/arx-onedrive-media-archive/logs
