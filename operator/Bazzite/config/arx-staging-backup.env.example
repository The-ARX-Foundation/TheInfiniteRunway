# Copy to ~/.config/arx-staging-backup.env and adjust paths.
#
# Canonical clone (where you edit and run git):
ARX_STAGING_SOURCE=/home/YOU/The ARX Foundation/Staging_Zettelkasten
#
# One-way mirror target (inside a directory synced to the cloud):
ARX_STAGING_BACKUP_DEST=/home/YOU/OneDrive/The ARX Foundation/Staging_Zettelkasten
#
# Optional overrides:
# ARX_STAGING_LOG_DIR=/home/YOU/.local/state/arx-staging-backup/logs
# ARX_STAGING_ENV_FILE=/home/YOU/.config/arx-staging-backup.env
